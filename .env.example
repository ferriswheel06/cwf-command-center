# ---- Railway injects this automatically when you attach a PostgreSQL plugin ----
DATABASE_URL=postgres://user:pass@host:5432/railway

# ---- auth ----
JWT_SECRET=replace-with-a-long-random-string
# SHA-256 hex of your login password. Default password fares2026 →
PASSWORD_HASH=
# 7-day sessions (decided 2026-06-07)

# ---- free AI bridge → the Cloudflare crm-api Worker (Workers AI lives there, $0) ----
AI_SERVICE_URL=https://api.carswithfares.ca

# ---- lead alerts → existing Telegram bot (kept) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=5827773980

# ---- runtime ----
PORT=3000
